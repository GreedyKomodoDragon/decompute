{
  "$schema": "https://opencode.ai/config.json",
  "model": "decompute/tiny-model",
  "providers": {
    "decompute": {
      "name": "Local Decompute",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "tiny-model": {
          "name": "Qwen2.5 0.5B via Decompute",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 1024
          }
        }
      }
    }
  }
}

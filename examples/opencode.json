{
  "$schema": "https://opencode.ai/config.json",
  "model": "decompute/tiny-model",
  "provider": {
    "decompute": {
      "name": "Local Decompute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "tiny-model": {
          "name": "Qwen2.5 0.5B via Decompute",
          "limit": {
            "context": 32768,
            "output": 1024
          }
        }
      }
    }
  }
}
